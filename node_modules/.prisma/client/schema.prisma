generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id       Int       @id @default(autoincrement())
  name     String
  email    String    @unique
  products Product[]
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Int
  stock     Int
  category  String?
  createdAt DateTime @default(now())

  userId Int
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)
}
